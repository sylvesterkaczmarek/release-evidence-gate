{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__release__publish_commit$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/check_release.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
